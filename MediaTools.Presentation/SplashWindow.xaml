<Window x:Class="MediaTools.Presentation.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Media Tools"
        Width="820"
        Height="480"
        MinWidth="760"
        MinHeight="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
        <ResourceDictionary Source="/Themes/AppColors.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="SplashTitleMain" TargetType="Run">
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource SideMenuTextBrush}" />
      </Style>
      <Style x:Key="SplashTitleAccent" TargetType="Run">
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Outer breathing room + soft halo -->
  <Border Padding="10">
    <Border CornerRadius="28"
            ClipToBounds="True"
            Background="#FF0A1424">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40"
                          Direction="270"
                          ShadowDepth="8"
                          Opacity="0.55"
                          Color="#FF000000" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main split -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Hero / logo column -->
          <Grid Grid.Column="0">
            <Grid.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{StaticResource AccentDarkColor}" />
                <GradientStop Offset="0.55" Color="{StaticResource SideMenuActiveColor}" />
                <GradientStop Offset="1" Color="{StaticResource SideMenuBackgroundColor}" />
              </LinearGradientBrush>
            </Grid.Background>

            <!-- Soft glow orbs -->
            <Ellipse Width="220"
                     Height="220"
                     Margin="-40,-30,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Offset="0" Color="#554DA3E8" />
                  <GradientStop Offset="1" Color="#000078D7" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="180"
                     Height="180"
                     Margin="0,0,-50,-40"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Offset="0" Color="#330078D7" />
                  <GradientStop Offset="1" Color="#000F1B2E" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <Border Padding="36"
                    VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center">
                <Border Padding="32"
                        HorizontalAlignment="Center"
                        CornerRadius="24"
                        Background="#40FFFFFF">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      Direction="270"
                                      ShadowDepth="0"
                                      Opacity="0.35"
                                      Color="#FF000000" />
                  </Border.Effect>
                  <Image x:Name="LogoImage"
                         Width="168"
                         Height="168"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         SnapsToDevicePixels="True"
                         Stretch="Uniform"
                         Source="pack://application:,,,/optimizing.png" />
                </Border>

                <TextBlock Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#99E8EEF5"
                           Text="MEDIA TOOLKIT" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Brand + status column -->
          <Grid Grid.Column="1">
            <Border Padding="44,48,44,24">
              <StackPanel VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap"
                           LineHeight="44">
                  <Run Style="{StaticResource SplashTitleMain}" Text="Media " />
                  <Run Style="{StaticResource SplashTitleAccent}" Text="Tools" />
                </TextBlock>

                <TextBlock Margin="0,14,0,0"
                           FontSize="15"
                           Foreground="{StaticResource SideMenuMutedTextBrush}"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Text="Optimize, compress, and enhance your media — one calm workspace for everyday workflows." />

                <Border Margin="0,32,0,0"
                        Padding="20,18"
                        CornerRadius="16"
                        BorderThickness="1"
                        Background="#18FFFFFF">
                  <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource AccentPrimaryColor}" Opacity="0.35" />
                  </Border.BorderBrush>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:ProgressRing x:Name="BusyRing"
                                           Grid.Column="0"
                                           Width="40"
                                           Height="40"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           IsActive="True" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                      <TextBlock FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="#CCB8C5D9"
                                 Text="STATUS" />
                      <TextBlock x:Name="StatusMessageText"
                                 Margin="0,6,0,0"
                                 FontSize="14"
                                 Foreground="{StaticResource SideMenuTextBrush}"
                                 Text="Preparing workspace…"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- Column divider -->
            <Border Width="1"
                    HorizontalAlignment="Left"
                    Background="#14FFFFFF" />
          </Grid>
        </Grid>

        <!-- Footer strip -->
        <Border Grid.Row="1"
                Padding="28,14,28,18"
                Background="#14000000"
                BorderThickness="0,1,0,0">
          <Border.BorderBrush>
            <SolidColorBrush Color="#FFFFFFFF" Opacity="0.06" />
          </Border.BorderBrush>
          <TextBlock x:Name="VersionFooterText"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#995C6B82"
                     Text="" />
        </Border>
      </Grid>
    </Border>
  </Border>
</Window>
