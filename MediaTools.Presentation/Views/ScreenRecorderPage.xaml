<Page x:Class="MediaTools.Presentation.Views.ScreenRecorderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Screen Recorder"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="ScreenRecorderScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=ScreenRecorderScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">
          <StackPanel Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Screen Recorder" />
            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                       Text="Capture your desktop or a custom region using the bundled FFmpeg. Add a microphone track, pick frame rate and quality, and export to MP4 or MKV." />
            <TextBlock Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="#FF5F6B76"
                       TextWrapping="Wrap">
              <Run Text="Video encoder: " />
              <Run FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding ExportVideoEncoderDisplay, Mode=OneWay}" />
              <Run Text=" (from App settings → Hardware Encoder; saved preferences + encoder scan)." />
            </TextBlock>
          </StackPanel>

          <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Capture region" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Region" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Output format" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Visibility="{Binding ShowPrimaryMonitorHint, Converter={StaticResource BoolToVisibilityConverter}}"
                         Text="Captures only the primary monitor at its native resolution." />

              <Button Margin="0,12,0,0"
                      HorizontalAlignment="Left"
                      Click="OnDrawRegionOnScreenClick"
                      Content="Draw region on screen…"
                      Style="{DynamicResource OutlinedButtonStyle}" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="11"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Opens a fullscreen overlay: drag to outline the region, set delay if you want, then Start recording. Countdown runs in the overlay; recording begins automatically (the main page delay is skipped). Esc / Cancel closes; during countdown they only stop the timer." />

              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding ShowCustomRegionEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF5F6B76" Text="Custom rectangle (pixels, optional)" />
                <UniformGrid Margin="0,6,0,0" Columns="4">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="X" />
                    <TextBox Margin="0,4,0,0" Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Y" />
                    <TextBox Margin="0,4,0,0" Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Width" />
                    <TextBox Margin="0,4,0,0" Text="{Binding CaptureWidth, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Height" />
                    <TextBox Margin="0,4,0,0" Text="{Binding CaptureHeight, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Quality &amp; timing" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Frame rate (fps)" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Start delay (s)" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding StartDelays}" SelectedItem="{Binding StartDelaySeconds}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,12,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Quality (CRF — lower is better, larger file)" />
              <Slider Maximum="40" Minimum="14" SmallChange="1" LargeChange="2" Value="{Binding Crf}" />
              <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="{Binding Crf, StringFormat='{}CRF {0}'}" />

              <CheckBox Margin="0,14,0,0" Content="Capture mouse cursor" IsChecked="{Binding CaptureCursor}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Microphone" />
              <CheckBox Content="Record microphone audio" IsChecked="{Binding IncludeMicrophone}" />
              <Grid Margin="0,12,0,0"
                    Visibility="{Binding ShowMicrophonePicker, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding MicrophoneDevices}"
                          SelectedItem="{Binding SelectedMicrophone}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Command="{Binding RefreshDevicesCommand}"
                        Content="Refresh"
                        Style="{DynamicResource OutlinedButtonStyle}" />
              </Grid>
              <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Devices come from FFmpeg DirectShow. System audio (loopback) is not captured." />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowRecordingPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal"
                          Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVisibilityConverter}}">
                <iconPacks:PackIconMaterial Width="22" Height="22" VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentPrimaryBrush}" Kind="TimerSandComplete" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                           Text="{Binding CountdownSeconds, StringFormat='Starting in {0}s…'}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal"
                          Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}">
                <Ellipse Width="14" Height="14" VerticalAlignment="Center" Fill="#FFE53935" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}" />
              </StackPanel>

              <TextBlock Margin="0,12,0,0" FontSize="40" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ElapsedDisplay}"
                         Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22" Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}" Text="Recording saved" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder" Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100" Command="{Binding CancelRecordingCommand}" Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="180" Command="{Binding StopRecordingCommand}" Content="Stop &amp; save"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220" Command="{Binding StartRecordingCommand}" Content="Start recording"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibilityConverter}}" />
          </StackPanel>
        </StackPanel>

        <Expander Grid.Column="1"
                  MinWidth="260"
                  MaxWidth="400"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  ExpandDirection="Down"
                  Header="Tips &amp; reference"
                  IsExpanded="False">
          <StackPanel>
            <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="How it works" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="FFmpeg's gdigrab captures the desktop with libx264 encoding. Press Stop &amp; save to finalize the file gracefully — Cancel discards in-progress output." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Tips" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Lower CRF for better quality (file size grows quickly). 30 fps is a good default; 60 fps doubles file size. 90/120 fps target smooth high-rate exports: the desktop is captured at up to 60 real frames per second, then frames are duplicated to match your choice (GDI cannot reliably grab faster). MKV is more crash-tolerant; MP4 plays everywhere." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Output folder" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Recordings are saved to the folder set in App settings using a screen_recording_yyyyMMdd_HHmmss filename." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
