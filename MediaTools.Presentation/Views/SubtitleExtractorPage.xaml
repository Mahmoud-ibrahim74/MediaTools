<Page x:Class="MediaTools.Presentation.Views.SubtitleExtractorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Subtitle Extractor"
      AllowDrop="True"
      Drop="OnDrop"
      DragEnter="OnDragEnter"
      DragLeave="OnDragLeave"
      DragOver="OnDragOver"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Page.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
  </Page.InputBindings>
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="SubtitleExtractorScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=SubtitleExtractorScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Subtitle Extractor" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Pull embedded subtitle tracks from MKV, MP4, and other containers into SRT, WebVTT, ASS, or a raw stream copy when FFmpeg supports it." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      Padding="0"
                      Command="{Binding UndoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Undo (Ctrl+Z)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Undo" />
              </Button>
              <Button Width="40"
                      Height="40"
                      Padding="0"
                      Command="{Binding RedoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Redo (Ctrl+Y)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Redo" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Padding="20">
            <Border.Style>
              <Style BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropHover}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <iconPacks:PackIconMaterial Width="48" Height="48" HorizontalAlignment="Center"
                                          Foreground="{DynamicResource AccentPrimaryBrush}" Kind="SubtitlesOutline" />
              <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                         Text="Drag &amp; drop a video here" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FF5F6B76" TextAlignment="Center"
                         Text="MP4, MKV, MOV, AVI, WebM, and more" />
              <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding BrowseFileCommand}"
                      Content="Browse video" Style="{DynamicResource OutlinedButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowFileInfoCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" LastChildFill="True">
                <Button Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Command="{Binding ClearFileCommand}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource OutlinedButtonStyle}">
                  <iconPacks:PackIconMaterial Width="16" Height="16" Kind="Close" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding FileDisplayName}"
                           TextWrapping="Wrap" />
              </DockPanel>

              <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}"
                           Foreground="#FF5F6B76"
                           Text="Scanning for subtitle tracks…" />
                <Border Padding="16"
                        Background="#FFFFF8E1"
                        BorderBrush="#FFFFE082"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowNoSubtitleTracksWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock Foreground="#FF6D4C41" TextWrapping="Wrap"
                             Text="No embedded subtitle tracks were found in this file." />
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="2"
                          Margin="0,14,0,0"
                          Visibility="{Binding ShowSubtitleTrackPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF5F6B76" Text="Subtitle track" />
                <ComboBox Margin="0,6,0,0"
                          DisplayMemberPath="DisplayLabel"
                          ItemsSource="{Binding SubtitleTracks}"
                          SelectedItem="{Binding SelectedTrack}" />
              </StackPanel>

              <UniformGrid Grid.Row="3" Margin="0,14,0,0" Columns="3">
                <StackPanel Margin="0,0,12,0">
                  <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Size" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding FileSizeDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Duration" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding DurationDisplay}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Video / hint" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding FormatDisplay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </UniformGrid>
            </Grid>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Export" />
              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Output format" />
              <ComboBox Margin="0,0,0,12" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ExportFormat}" />
              <TextBlock FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="SubRip, WebVTT, and ASS re-encode the track when needed. Copy keeps the original bitstream (text or bitmap); the file extension follows the codec." />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding ProgressStatusText}" />
              <TextBlock Margin="0,6,0,0" Foreground="#FF5F6B76" Text="{Binding ProgressDetailText}" />
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True" Background="#FFE8EEF4">
                <ProgressBar Height="12" Maximum="100" Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>
              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22" Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}" Text="Saved successfully" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder" Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100" Command="{Binding CancelCommand}" Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220" Command="{Binding ExtractSubtitleCommand}" Content="Extract subtitle"
                    Style="{DynamicResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="260"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch">
          <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Track list" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Each entry is an embedded stream FFmpeg can map. Stream index must match the container; if extraction fails, try “Copy without re-encode” or another format." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Limitations" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Bitmap subtitles (e.g. PGS) cannot become SRT without OCR. Re-encoding to SubRip may fail for those tracks — use copy mode instead." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
