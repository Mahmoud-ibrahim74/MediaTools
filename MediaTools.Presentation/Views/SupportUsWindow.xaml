<mah:MetroWindow x:Class="MediaTools.Presentation.Views.SupportUsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="Support Us"
                 Width="520" Height="630"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowMaxRestoreButton="False"
                 ShowMinButton="False"
                 Background="{DynamicResource ContentBackgroundBrush}"
                 GlowBrush="{DynamicResource AccentPrimaryBrush}">
    <mah:MetroWindow.Resources>
        <Style x:Key="PaymentCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <!-- Overlay for hover effects -->
                                <Border x:Name="overlay" CornerRadius="11" Background="Transparent" />
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="overlay" Property="Background" Value="#10007ACC" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="Black" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="#20007ACC" />
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="Black" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Border Padding="32,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,24">
                    <iconPacks:PackIconMaterial Kind="CreditCardOutline" Width="26" Height="26" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Payment Method" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Vodafone Cash -->
                <Button Style="{StaticResource PaymentCardStyle}" Click="Copy_Click" CommandParameter="01069903556" ToolTip="Click anywhere to copy to clipboard!">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                            <!-- Vodafone Red Circle -->
                            <Ellipse Width="34" Height="34" Stroke="#E60000" StrokeThickness="4" Fill="Transparent" />
                        </Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="Vodafone Cash" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="01069903556" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Column="2" Kind="ContentCopy" Width="20" Height="20" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- InstaPay -->
                <Button Style="{StaticResource PaymentCardStyle}" Click="Copy_Click" CommandParameter="mahmoud.ibrahim74@instapay" ToolTip="Click anywhere to copy to clipboard!">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
                            <iconPacks:PackIconMaterial Kind="LightningBolt" Width="28" Height="28" Foreground="#FF7A308B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="InstaPay" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="mahmoud.ibrahim74@instapay" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Column="2" Kind="ContentCopy" Width="20" Height="20" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- Bank Transfer -->
                <Button Style="{StaticResource PaymentCardStyle}" Click="Copy_Click" CommandParameter="100061518902" ToolTip="Click anywhere to copy to clipboard!">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#E8EAF6" BorderThickness="0">
                            <iconPacks:PackIconMaterial Kind="Bank" Width="28" Height="28" Foreground="#FF3F51B5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="Bank Transfer" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="Account Number: 100061518902" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Column="2" Kind="ContentCopy" Width="20" Height="20" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- Emotional Message Box -->
                <Border Margin="0,16,0,0" Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="#30E53935" Background="#10E53935">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0" Kind="Heart" Width="36" Height="36" Foreground="#FFE53935" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="22" FontWeight="Medium">
                            <Run Text="Your support means the world to me. Every contribution, no matter how small, fuels the passion and dedication I pour into making Media Tools better for you. Thank you from the bottom of my heart!" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
