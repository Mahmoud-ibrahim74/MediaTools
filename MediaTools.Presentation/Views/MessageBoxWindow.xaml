<mah:MetroWindow x:Class="MediaTools.Presentation.Views.MessageBoxWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="{Binding Caption}"
                 Width="460"
                 MinHeight="180"
                 MaxWidth="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ShowMaxRestoreButton="False"
                 ShowMinButton="False"
                 GlowBrush="{DynamicResource AccentPrimaryBrush}"
                 BorderThickness="0"
                 Background="{DynamicResource ContentBackgroundBrush}">
  <Border Margin="20"
          Background="{DynamicResource CardBackgroundBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24"
                        Direction="270"
                        ShadowDepth="4"
                        Opacity="0.14"
                        Color="#33000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="4" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="AccentStripe"
              Grid.Row="0"
              CornerRadius="12,12,0,0"
              Background="{DynamicResource AccentPrimaryBrush}" />

      <Grid Grid.Row="1" Margin="22,20,22,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBadge"
                Grid.Column="0"
                Width="52"
                Height="52"
                Margin="0,0,16,0"
                VerticalAlignment="Top"
                Background="#140078D7"
                BorderBrush="#330078D7"
                BorderThickness="1.5"
                CornerRadius="26">
          <iconPacks:PackIconMaterial x:Name="DialogIcon"
                                      Width="26"
                                      Height="26"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentPrimaryBrush}"
                                      Kind="InformationOutline" />
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="220"
                      HorizontalScrollBarVisibility="Disabled">
          <TextBlock FontSize="14"
                     LineHeight="22"
                     Foreground="#FF3D4A5C"
                     Text="{Binding Message}"
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </Grid>

      <StackPanel x:Name="ButtonPanel"
                  Grid.Row="2"
                  Margin="22,4,22,20"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal" />
    </Grid>
  </Border>
</mah:MetroWindow>
