<Page x:Class="MediaTools.Presentation.Views.YouTubeVideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="YouTube Video Downloader"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}"
        UseLayoutRounding="True">
    <ScrollViewer x:Name="YouTubeVideoScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=YouTubeVideoScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- HEADER with animated waveform bars                    -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="YouTube Video Downloader" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Paste a YouTube link below to download high-quality video. Choose your format and resolution, then download." />
            </StackPanel>

            <!-- Animated waveform decoration -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Opacity="0.6">
              <StackPanel.Resources>
                <Storyboard x:Key="WaveAnim" RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                                   From="8" To="32" Duration="0:0:0.4" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                                   From="24" To="12" Duration="0:0:0.5" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                                   From="12" To="28" Duration="0:0:0.35" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height"
                                   From="20" To="8" Duration="0:0:0.45" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height"
                                   From="16" To="32" Duration="0:0:0.38" AutoReverse="True" />
                </Storyboard>
              </StackPanel.Resources>
              <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard Storyboard="{StaticResource WaveAnim}" />
                </EventTrigger>
              </StackPanel.Triggers>
              <Border x:Name="Bar1" Width="4" Height="8" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar2" Width="4" Height="24" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar3" Width="4" Height="12" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar4" Width="4" Height="20" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar5" Width="4" Height="16" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- URL INPUT CARD                                        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <iconPacks:PackIconMaterial Width="22" Height="22"
                                            VerticalAlignment="Center"
                                            Foreground="#FFFF0000"
                                            Kind="Youtube" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15"
                           Text="YouTube Link" />
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Padding="12,10"
                         FontSize="14"
                         Text="{Binding YoutubeUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                      <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding PasteFromClipboardCommand}"
                        Style="{DynamicResource OutlinedButtonStyle}"
                        ToolTip="Paste YouTube URL from clipboard">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentPaste" />
                    <TextBlock VerticalAlignment="Center" Text="Paste" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="110"
                        Command="{Binding FetchVideoInfoCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="Magnify" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding FetchButtonText}" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Fetching spinner -->
              <StackPanel Orientation="Horizontal"
                          Margin="0,12,0,0"
                          Visibility="{Binding IsFetching, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="16" Height="16" CornerRadius="8"
                        BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                  <Border.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" />
                  </Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                           Storyboard.TargetProperty="Angle"
                                           From="0" To="360" Duration="0:0:1" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Border.Triggers>
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF5F6B76"
                           Text="Fetching video information…" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- ERROR CARD                                            -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="16"
                  BorderBrush="{DynamicResource StatusDangerBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                  Visibility="{Binding ShowErrorCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            Foreground="{DynamicResource StatusDangerBrush}"
                                            Kind="AlertCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusDangerBrush}"
                           Text="Error" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                         Foreground="#FF5F6B76"
                         Text="{Binding ErrorMessage}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- VIDEO INFO CARD (shown after successful fetch)        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="0"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowVideoInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="10" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Thumbnail + gradient overlay -->
                <Grid Grid.Row="0" Height="200">
                  <Image Source="{Binding ThumbnailImage}"
                         Stretch="UniformToFill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                  <!-- Gradient overlay for text readability -->
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.3" />
                        <GradientStop Color="#CC000000" Offset="1.0" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <!-- Video title overlay on thumbnail -->
                  <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="52"
                               Text="{Binding VideoTitle}" />
                  </StackPanel>
                  <!-- Duration badge -->
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,12,12,0" Padding="8,4"
                          CornerRadius="6"
                          Background="#CC000000">
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding DurationDisplay}" />
                  </Border>
                </Grid>

                <!-- Video metadata row -->
                <Border Grid.Row="1" Padding="20,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="16" Height="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF5F6B76"
                                                    Kind="AccountCircleOutline" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Text="{Binding ChannelName}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <iconPacks:PackIconMaterial Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF9AA7B8"
                                                    Kind="Eye" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#FF9AA7B8"
                                   Text="{Binding ViewCountDisplay}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Padding="10,6"
                            CornerRadius="16"
                            Background="#14FF0000">
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FFFF0000"
                                                    Kind="Youtube" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FFCC0000"
                                   Text="YouTube" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- FORMAT & QUALITY CARD                                 -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowVideoInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="TuneVariant" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15"
                           Text="Format, Resolution &amp; Quality" />
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Video format" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableFormats}"
                            SelectedItem="{Binding SelectedFormat}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Resolution" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableResolutions}"
                            SelectedItem="{Binding SelectedResolution}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Video quality" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableQualities}"
                            SelectedItem="{Binding SelectedQuality}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#FF9AA7B8" TextWrapping="Wrap"
                         Text="Quality changes the video compression bitrate. High preserves quality but increases size. Low minimizes file size." />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- PLAYLIST ITEMS CARD                                     -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="0" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowPlaylistItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <Border Padding="20,16,20,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <iconPacks:PackIconMaterial Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                                Kind="PlaylistPlay" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="15"
                               Text="Playlist Videos" />
                  </StackPanel>
                  <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                            Content="Select all"
                            IsEnabled="{Binding IsNotDownloading}"
                            IsChecked="{Binding SelectAllItems, Mode=TwoWay}" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding PlaylistItems}" Margin="0,8,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      
                      <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Margin="0,2,12,0" VerticalAlignment="Top"
                                  IsEnabled="{Binding DataContext.IsNotDownloading, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock FontWeight="Medium" FontSize="14" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="{Binding DurationDisplay}" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="#FF5F6B76" Text="{Binding ProgressStatusText}" 
                                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource StatusSuccessBrush}" Text="Complete" 
                                       Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource StatusDangerBrush}" Text="{Binding ErrorMessage}" 
                                       Visibility="{Binding IsError, Converter={StaticResource BoolToVisibilityConverter}}" />
                          </StackPanel>
                          <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100"
                                       Style="{DynamicResource MetroProgressBarRounded}"
                                       Value="{Binding ProgressPercentDisplay, Mode=OneWay}"
                                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Padding="12,6"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{DynamicResource OutlinedButtonStyle}"
                                Margin="0,0,8,0">
                           <StackPanel Orientation="Horizontal">
                             <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,6,0" Kind="Close" />
                             <TextBlock FontSize="12" Text="Cancel" />
                           </StackPanel>
                        </Button>
                        <Button Padding="12,6"
                                Command="{Binding DownloadCommand}"
                                Style="{DynamicResource OutlinedButtonStyle}">
                           <StackPanel Orientation="Horizontal">
                             <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,6,0" Kind="Download" />
                             <TextBlock FontSize="12" Text="Download" />
                           </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- DOWNLOAD PROGRESS CARD                                -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Download" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding ProgressStatusText}" />
              </StackPanel>

              <!-- Speed / ETA row -->
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="#FF5F6B76"
                           Text="{Binding DownloadSpeedDisplay}" />
                <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="#FF5F6B76"
                           Text="{Binding EtaDisplay, StringFormat='ETA: {0}'}" />
              </StackPanel>

              <!-- Progress bar with glow -->
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True"
                      Background="#FFE8EEF4">
                <ProgressBar Height="14" Maximum="100"
                             Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>

              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />

              <!-- Animated waveform during download -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          Margin="0,8,0,0" Opacity="0.4">
                <StackPanel.Resources>
                  <Storyboard x:Key="DownloadWaveAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="DBar1" Storyboard.TargetProperty="Height"
                                     From="4" To="18" Duration="0:0:0.3" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar2" Storyboard.TargetProperty="Height"
                                     From="14" To="6" Duration="0:0:0.4" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar3" Storyboard.TargetProperty="Height"
                                     From="6" To="20" Duration="0:0:0.25" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar4" Storyboard.TargetProperty="Height"
                                     From="16" To="4" Duration="0:0:0.35" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar5" Storyboard.TargetProperty="Height"
                                     From="10" To="22" Duration="0:0:0.28" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar6" Storyboard.TargetProperty="Height"
                                     From="8" To="16" Duration="0:0:0.42" AutoReverse="True" />
                    <DoubleAnimation Storyboard.TargetName="DBar7" Storyboard.TargetProperty="Height"
                                     From="18" To="6" Duration="0:0:0.32" AutoReverse="True" />
                  </Storyboard>
                </StackPanel.Resources>
                <StackPanel.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource DownloadWaveAnim}" />
                  </EventTrigger>
                </StackPanel.Triggers>
                <Border x:Name="DBar1" Width="3" Height="4" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar2" Width="3" Height="14" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar3" Width="3" Height="6" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar4" Width="3" Height="16" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar5" Width="3" Height="10" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar6" Width="3" Height="8" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
                <Border x:Name="DBar7" Width="3" Height="18" Margin="1,0" CornerRadius="1.5"
                        Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- SUCCESS CARD                                          -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="16"
                  BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22"
                                            Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}"
                           Text="Download complete!" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                      Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder"
                      Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- ACTION BUTTONS                                        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220"
                    Command="{Binding DownloadVideoCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="18" Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Download" />
                <TextBlock VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Download Video" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPlaylistItems}" Value="True">
                          <Setter Property="Text" Value="Download Selected" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- TIPS SIDEBAR                                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Expander Grid.Column="1"
                  MinWidth="260"
                  MaxWidth="400"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  ExpandDirection="Down"
                  Header="Tips &amp; reference"
                  IsExpanded="False">
          <StackPanel>
            <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Supported URLs" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Paste any YouTube video link (youtube.com/watch?v=… or youtu.be/…). Playlists are also supported." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Format guide" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="MP4 (universal), MKV (modern container with subtitle support), WebM (great for the web)." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Quality tips" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Selecting 'Best' guarantees the highest available resolution. If you select 4K but the video is only 1080p, the best available quality will be downloaded." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="First-time setup" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="On first use, the app downloads yt-dlp (~10 MB). Subsequent downloads start instantly. All processing runs locally on your machine." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
