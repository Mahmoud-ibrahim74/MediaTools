<Page x:Class="MediaTools.Presentation.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      Title="Dashboard"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="DashboardScroll"
                  Padding="28"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
      <Grid Width="{Binding ViewportWidth, ElementName=DashboardScroll}"
            HorizontalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Stretch">
      <StackPanel Margin="0,0,0,24">
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="Dashboard" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="14"
                   Foreground="#FF5F6B76"
                   Text="Overview of your MediaTools usage and quick access to tools." />
      </StackPanel>

      <UniformGrid Margin="0,0,0,24"
                   Columns="3">
        <Border Margin="0,0,12,12"
                Style="{DynamicResource CardBorderStyle}">
          <StackPanel>
            <TextBlock FontSize="13"
                       Foreground="#FF5F6B76"
                       Text="Videos compressed" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentPrimaryBrush}"
                       Text="{Binding TotalVideosCompressed}" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,12,12"
                Style="{DynamicResource CardBorderStyle}">
          <StackPanel>
            <TextBlock FontSize="13"
                       Foreground="#FF5F6B76"
                       Text="Total space saved" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentPrimaryBrush}"
                       Text="{Binding TotalSpaceSavedDisplay}" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,0,12"
                Style="{DynamicResource CardBorderStyle}">
          <StackPanel>
            <TextBlock FontSize="13"
                       Foreground="#FF5F6B76"
                       Text="Avg. compression" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentPrimaryBrush}"
                       Text="{Binding AverageCompressionRatioDisplay}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock Margin="0,8,0,12"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Text="Tools" />

      <UniformGrid Columns="2">
        <Border Margin="0,0,12,12"
                Cursor="Hand"
                Style="{DynamicResource CardBorderStyle}">
          <Border.InputBindings>
            <MouseBinding Command="{Binding GoToVideoCompressCommand}"
                          MouseAction="LeftClick" />
          </Border.InputBindings>
          <Border.Background>
            <SolidColorBrush Color="White" />
          </Border.Background>
          <Grid Margin="4">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="26"
                                            Height="26"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="FolderZipOutline" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Video Compress" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Shrink video files with intelligent codec presets and advanced tuning." />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,0,0,12"
                Cursor="Hand"
                Style="{DynamicResource CardBorderStyle}">
          <Border.InputBindings>
            <MouseBinding Command="{Binding GoToPhotoEnhancerCommand}"
                          MouseAction="LeftClick" />
          </Border.InputBindings>
          <Border.Background>
            <SolidColorBrush Color="White" />
          </Border.Background>
          <Grid Margin="4">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="26"
                                            Height="26"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="ImageFilterHdrOutline" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Photo Enhancer" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Convert formats, upscale with AI-style enhancement, and apply creative filters." />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,0,12,0"
                Opacity="0.45"
                Style="{DynamicResource CardBorderStyle}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Width="26"
                                          Height="26"
                                          Foreground="#FF9AA7B8"
                                          Kind="MusicNoteOutline" />
              <TextBlock Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="Audio Extract" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FFC62828"
                       Text="Coming soon" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
