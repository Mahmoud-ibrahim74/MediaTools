<Page x:Class="MediaTools.Presentation.Views.AudioEnhancerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Audio Converter"
      AllowDrop="True"
      Drop="OnDrop"
      DragEnter="OnDragEnter"
      DragLeave="OnDragLeave"
      DragOver="OnDragOver"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Page.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
  </Page.InputBindings>
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="AudioEnhancerScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=AudioEnhancerScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Audio Converter &amp; Enhancer" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Tune each tool below and check “Include … in export” for every effect you want in the final file. One export runs vocal → noise → silence → clarity → levels together. FFmpeg runs locally." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      Padding="0"
                      Command="{Binding UndoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Undo (Ctrl+Z)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Undo" />
              </Button>
              <Button Width="40"
                      Height="40"
                      Padding="0"
                      Command="{Binding RedoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Redo (Ctrl+Y)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Redo" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Padding="20">
            <Border.Style>
              <Style BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropHover}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <iconPacks:PackIconMaterial Width="48" Height="48" HorizontalAlignment="Center"
                                          Foreground="{DynamicResource AccentPrimaryBrush}" Kind="MusicNoteOutline" />
              <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                         Text="Drag &amp; drop an audio file here" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FF5F6B76" TextAlignment="Center"
                         Text="MP3, WAV, FLAC, AAC, M4A, OGG, OPUS, and more" />
              <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding BrowseFileCommand}"
                      Content="Browse audio" Style="{DynamicResource OutlinedButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowFileInfoCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" LastChildFill="True">
                <Button Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Command="{Binding ClearFileCommand}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource OutlinedButtonStyle}">
                  <iconPacks:PackIconMaterial Width="16" Height="16" Kind="Close" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding FileDisplayName}"
                           TextWrapping="Wrap" />
              </DockPanel>

              <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock FontWeight="SemiBold" Text="Live preview" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#FF5F6B76"
                           TextWrapping="Wrap"
                           Text="Pick Source or With current settings, adjust options, then press Play to hear the preview. Pause anytime; the preview clip refreshes shortly after you change sliders (processed mode)." />

                <Border Margin="0,10,0,0"
                        Padding="10,10,2,2"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <WrapPanel Orientation="Horizontal">
                    <Button Command="{Binding SelectPreviewListenModeCommand}"
                            CommandParameter="0"
                            Content="Source">
                      <Button.Style>
                        <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewSourceMode}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                              <Setter Property="Foreground" Value="White" />
                              <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Command="{Binding SelectPreviewListenModeCommand}"
                            CommandParameter="1"
                            Content="With current settings">
                      <Button.Style>
                        <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewProcessedMode}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                              <Setter Property="Foreground" Value="White" />
                              <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </WrapPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        MinHeight="88"
                        Background="#FF101418"
                        CornerRadius="8"
                        ClipToBounds="True">
                  <Grid>
                    <!-- Opacity must stay at 1: WMF audio often does not output when the element is fully transparent. -->
                    <!-- LoadedBehavior=Manual: required so code-behind can Play(), set Position, and loop. UnloadedBehavior=Close releases the file on unload. -->
                    <MediaElement x:Name="AudioPreviewPlayer"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  LoadedBehavior="Manual"
                                  IsHitTestVisible="False"
                                  IsMuted="{Binding PreviewMuted}"
                                  MediaEnded="OnAudioPreviewMediaEnded"
                                  MediaFailed="OnAudioPreviewMediaFailed"
                                  MediaOpened="OnAudioPreviewMediaOpened"
                                  ScrubbingEnabled="True"
                                  Source="{Binding PreviewMediaUri}"
                                  UnloadedBehavior="Close"
                                  Volume="1" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="16"
                                IsHitTestVisible="False">
                      <iconPacks:PackIconMaterial Width="40"
                                                    Height="40"
                                                    HorizontalAlignment="Center"
                                                    Foreground="#66FFFFFF"
                                                    Kind="Headphones" />
                      <TextBlock Margin="0,10,0,0"
                                 HorizontalAlignment="Center"
                                 FontSize="12"
                                 Foreground="#99FFFFFF"
                                 Text="Use Play / Pause below — audio does not start automatically."
                                 TextAlignment="Center"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Background="#AA000000"
                            Visibility="{Binding IsPreviewBuilding, Converter={StaticResource BoolToVisibilityConverter}}">
                      <TextBlock Margin="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 Foreground="White"
                                 Text="Building preview…"
                                 TextAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                  <Button MinWidth="100"
                          Padding="12,8"
                          Click="OnPreviewPlayClick"
                          IsEnabled="{Binding CanPreviewPlaybackControls}"
                          Style="{DynamicResource PrimaryButtonStyle}"
                          ToolTip="Play preview from the start. If you hear nothing, uncheck “Mute preview” and confirm Windows volume.">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="18"
                                                  Height="18"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Kind="Play" />
                      <TextBlock VerticalAlignment="Center" Text="Play" />
                    </StackPanel>
                  </Button>
                  <Button MinWidth="100"
                          Margin="12,0,0,0"
                          Padding="12,8"
                          Click="OnPreviewPauseClick"
                          IsEnabled="{Binding CanPreviewPlaybackControls}"
                          Style="{DynamicResource OutlinedButtonStyle}"
                          ToolTip="Pause preview">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="18"
                                                  Height="18"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Kind="Pause" />
                      <TextBlock VerticalAlignment="Center" Text="Pause" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <TextBlock Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="#FF5F6B76"
                           Text="{Binding PreviewStatusText}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,8,0,0"
                          Content="Mute preview"
                          IsChecked="{Binding PreviewMuted}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <UniformGrid Columns="3">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Size" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding FileSizeDisplay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Duration" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DurationDisplay}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Codec" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding CodecDisplay}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </UniformGrid>
                <UniformGrid Margin="0,10,0,0" Columns="2">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Sample rate" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SampleRateDisplay}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Channels" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ChannelsDisplay}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Operation tabs (same pattern as PhotoEnhancerPage / VideoEnhancerPage) -->
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="Tools" />
              <TextBlock Margin="0,0,0,10"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Tabs only organize settings. Export always applies every checked “Include” option in one pass." />
              <Border Padding="10,10,2,2"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                <WrapPanel Orientation="Horizontal">
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="0"
                          Content="Enhance &amp; convert">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEnhanceWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="1"
                          Content="Vocal remover">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsVocalWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="2"
                          Content="Noise reduction">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsNoiseWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="3"
                          Content="Silence remover">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSilenceWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Vocal remover -->
          <Border Margin="0,16,0,0"
                  Padding="16"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding IsVocalWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Vocal remover" />
              <CheckBox Margin="0,0,0,10"
                        Content="Include vocal remover in export (stereo sources only)"
                        IsChecked="{Binding IncludeVocalRemover}" />
              <TextBlock Margin="0,0,0,12"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Blends mid (sum) and side (L−R) from a stereo track to approximate an instrumental. Mono sources cannot be processed — use a stereo mix." />
              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Instrumental blend (favor side)" />
              <Slider Margin="0,0,0,4" Maximum="1" Minimum="0" LargeChange="0.1" SmallChange="0.02"
                      Value="{Binding VocalRemoverStrength}" />
              <TextBlock Margin="0,0,0,8" FontSize="11" Foreground="#FF5F6B76"
                         Text="{Binding VocalRemoverStrength, StringFormat={}{0:0.00} — higher emphasizes difference channel}" />
              <Border Padding="10"
                      Background="#FFFFF8F0"
                      BorderBrush="{DynamicResource StatusWarningBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Visibility="{Binding ShowVocalStereoWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Foreground="#FF5F6B76"
                           TextWrapping="Wrap"
                           Text="This file is mono or single-channel. Vocal remover needs stereo audio." />
              </Border>
            </StackPanel>
          </Border>

          <!-- Noise reduction -->
          <Border Margin="0,16,0,0"
                  Padding="16"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding IsNoiseWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Noise reduction" />
              <CheckBox Margin="0,0,0,10"
                        Content="Include noise reduction in export"
                        IsChecked="{Binding IncludeNoiseReduction}" />
              <TextBlock Margin="0,0,0,12"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Spectral noise suppression (FFmpeg afftdn). Stronger settings remove more hiss but may thin the signal." />
              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Strength" />
              <Slider Margin="0,0,0,4" Maximum="1" Minimum="0.05" LargeChange="0.1" SmallChange="0.02"
                      Value="{Binding NoiseReductionStrength}" />
              <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="{Binding NoiseReductionStrength, StringFormat={}{0:0.00}}" />
            </StackPanel>
          </Border>

          <!-- Silence remover -->
          <Border Margin="0,16,0,0"
                  Padding="16"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding IsSilenceWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Silence remover" />
              <CheckBox Margin="0,0,0,10"
                        Content="Include silence removal in export"
                        IsChecked="{Binding IncludeSilenceRemover}" />
              <TextBlock Margin="0,0,0,12"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Trims runs of silence below the threshold. Uses FFmpeg silenceremove; very aggressive settings can clip breaths and room tone." />
              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Silence threshold (dB)" />
              <Slider Margin="0,0,0,4" Maximum="-15" Minimum="-60" LargeChange="5" SmallChange="1"
                      Value="{Binding SilenceThresholdDb}" />
              <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                         Text="{Binding SilenceThresholdDb, StringFormat={}{0:0} dB — lower values trim quieter passages.}" />

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Minimum silence to remove (seconds)" />
              <Slider Margin="0,0,0,4" Maximum="3" Minimum="0.05" LargeChange="0.1" SmallChange="0.05"
                      Value="{Binding MinSilenceDurationSec}" />
              <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                         Text="{Binding MinSilenceDurationSec, StringFormat={}{0:0.00} s}" />

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Detection window (seconds)" />
              <Slider Margin="0,0,0,4" Maximum="0.2" Minimum="0.01" LargeChange="0.02" SmallChange="0.005"
                      Value="{Binding SilenceDetectionWindowSec}" />
              <TextBlock FontSize="11" Foreground="#FF5F6B76"
                         Text="{Binding SilenceDetectionWindowSec, StringFormat={}{0:0.000} s}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Export &amp; levels" />
              <CheckBox Margin="0,0,0,12"
                        Content="Clarity boost (gentle high-frequency emphasis)"
                        IsChecked="{Binding ClarityBoost}" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Export format" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding TargetFormat}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding ShowBitrateControls, Converter={StaticResource BoolToVisibilityConverter}}">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Bitrate (lossy)" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding BitrateKbps}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Sample rate" />
              <ComboBox Margin="0,0,0,12" ItemsSource="{Binding SampleRateOptions}" SelectedItem="{Binding SampleRate}" />

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Output level (%)" />
              <Slider Margin="0,0,0,4" Maximum="200" Minimum="25" TickFrequency="5" IsSnapToTickEnabled="False"
                      Value="{Binding VolumePercent}" />
              <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                         Text="{Binding VolumePercent, StringFormat='{}{0}% — 100% is unchanged'}" />

              <CheckBox Content="Loudness normalize (streaming-friendly target)"
                        IsChecked="{Binding NormalizeLoudness}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding ProgressStatusText}" />
              <TextBlock Margin="0,6,0,0" Foreground="#FF5F6B76" Text="{Binding ProgressDetailText}" />
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True" Background="#FFE8EEF4">
                <ProgressBar Height="12" Maximum="100" Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>
              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22" Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}" Text="Saved successfully" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder" Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100" Command="{Binding CancelCommand}" Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220"
                    Command="{Binding ProcessAudioCommand}"
                    Content="Export audio"
                    Style="{DynamicResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="260"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch">
          <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Formats" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="MP3 and AAC (M4A) are ideal for sharing. FLAC is lossless. Opus in OGG offers great quality at low bitrates. WAV is uncompressed PCM." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Combined export" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Check each tool you want, then Export audio once. Processing order: vocal (optional) → noise → silence → clarity → volume and loudness." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
