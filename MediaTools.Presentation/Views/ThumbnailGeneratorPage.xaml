<Page x:Class="MediaTools.Presentation.Views.ThumbnailGeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Thumbnail Generator"
      AllowDrop="True"
      Drop="OnDrop"
      DragEnter="OnDragEnter"
      DragLeave="OnDragLeave"
      DragOver="OnDragOver"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Page.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
  </Page.InputBindings>
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="ThumbnailGeneratorScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=ThumbnailGeneratorScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Thumbnail Generator" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Create a smaller still image from a photo or a frame from a video — max edge, format, and optional seek time for clips." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      Padding="0"
                      Command="{Binding UndoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Undo (Ctrl+Z)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Undo" />
              </Button>
              <Button Width="40"
                      Height="40"
                      Padding="0"
                      Command="{Binding RedoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Redo (Ctrl+Y)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Redo" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Padding="20">
            <Border.Style>
              <Style BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropHover}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <iconPacks:PackIconMaterial Width="48" Height="48" HorizontalAlignment="Center"
                                          Foreground="{DynamicResource AccentPrimaryBrush}" Kind="ImageSizeSelectLarge" />
              <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                         Text="Drag &amp; drop an image or video here" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FF5F6B76" TextAlignment="Center"
                         Text="Raster images or common video containers (MP4, MKV, MOV, …)" />
              <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding BrowseFileCommand}"
                      Content="Browse file" Style="{DynamicResource OutlinedButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowFileInfoCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" LastChildFill="True">
                <Button Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Command="{Binding ClearFileCommand}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource OutlinedButtonStyle}">
                  <iconPacks:PackIconMaterial Width="16" Height="16" Kind="Close" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding FileDisplayName}"
                           TextWrapping="Wrap" />
              </DockPanel>

              <Border Grid.Row="1"
                      Margin="0,14,0,0"
                      Padding="4"
                      HorizontalAlignment="Stretch"
                      Background="#FFF5F7FA"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      ClipToBounds="True">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SourcePreviewImage}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Image MinHeight="160"
                       MaxHeight="280"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding SourcePreviewImage, Mode=OneWay}"
                       Stretch="Uniform" />
              </Border>

              <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <UniformGrid Columns="3">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Size" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding FileSizeDisplay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Duration" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DurationDisplay}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Dimensions" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DimensionsDisplay}" />
                  </StackPanel>
                </UniformGrid>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Format / codec" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding FormatDisplay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Thumbnail options" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Max edge (px)" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding MaxEdgeOptions}" SelectedItem="{Binding SelectedMaxEdge}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Output format" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" />
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowLossyQualityControls, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="JPEG / WebP quality" />
                <Slider Margin="0,0,0,4" Maximum="100" Minimum="1" TickFrequency="5" IsSnapToTickEnabled="False"
                        Value="{Binding JpegWebpQuality}" />
                <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="{Binding JpegWebpQuality, StringFormat='{}{0}'}" />
              </StackPanel>

              <StackPanel Visibility="{Binding ShowVideoTimeControls, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Frame time (seconds from start)" />
                <Slider Margin="0,0,0,4" Maximum="{Binding VideoTimeOffsetMaximum}" Minimum="0" IsSnapToTickEnabled="False"
                        SmallChange="0.5" LargeChange="2"
                        Value="{Binding VideoTimeOffsetSeconds}" />
                <TextBlock FontSize="11" Foreground="#FF5F6B76"
                           Text="{Binding VideoTimeOffsetSeconds, StringFormat='{}{0:0.##} s'}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding ProgressStatusText}" />
              <TextBlock Margin="0,6,0,0" Foreground="#FF5F6B76" Text="{Binding ProgressDetailText}" />
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True" Background="#FFE8EEF4">
                <ProgressBar Height="12" Maximum="100" Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>
              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22" Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}" Text="Saved successfully" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder" Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100" Command="{Binding CancelCommand}" Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220" Command="{Binding GenerateThumbnailCommand}" Content="Generate thumbnail"
                    Style="{DynamicResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="260"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch">
          <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="How it works" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Images are resized so the longest side matches your max edge (smaller images are not enlarged). Videos use FFmpeg to grab one frame at the chosen time." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Output folder" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Thumbnails are saved next to your other tool outputs — the folder set in App settings. The file name ends with _thumb plus the chosen extension." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
