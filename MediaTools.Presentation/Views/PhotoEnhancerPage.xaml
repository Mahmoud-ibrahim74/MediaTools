<Page x:Class="MediaTools.Presentation.Views.PhotoEnhancerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:domainEnums="clr-namespace:MediaTools.Domain.Enums;assembly=MediaTools.Domain"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Photo Enhancer"
      AllowDrop="True"
      Drop="OnDrop"
      DragEnter="OnDragEnter"
      DragLeave="OnDragLeave"
      DragOver="OnDragOver"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Page.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
  </Page.InputBindings>
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="PhotoEnhancerScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=PhotoEnhancerScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Photo Enhancer &amp; Converter" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Convert between formats, upscale with high-quality or AI-style enhancement, and apply creative filters for a professional finish — all in one place." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
              <Button Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      Padding="0"
                      Command="{Binding UndoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Undo (Ctrl+Z)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Undo" />
              </Button>
              <Button Width="40"
                      Height="40"
                      Padding="0"
                      Command="{Binding RedoCommand}"
                      Style="{DynamicResource OutlinedButtonStyle}"
                      ToolTip="Redo (Ctrl+Y)">
                <iconPacks:PackIconMaterial Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Redo" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Padding="20">
            <Border.Style>
              <Style BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropHover}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <iconPacks:PackIconMaterial Width="48" Height="48" HorizontalAlignment="Center"
                                          Foreground="{DynamicResource AccentPrimaryBrush}" Kind="ImageFilterHdrOutline" />
              <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                         Text="Drag &amp; drop an image here" />
              <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FF5F6B76" TextAlignment="Center"
                         Text="PNG, JPEG, WebP, BMP, TIFF, GIF" />
              <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding BrowseFileCommand}"
                      Content="Browse image" Style="{DynamicResource OutlinedButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowFileInfoCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DockPanel Grid.Row="0" LastChildFill="True">
                <Button Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Command="{Binding ClearFileCommand}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource OutlinedButtonStyle}">
                  <iconPacks:PackIconMaterial Width="16" Height="16" Kind="Close" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding FileDisplayName}"
                           TextWrapping="Wrap" />
              </DockPanel>

              <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Margin="0,0,0,6"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#FF5F6B76"
                             Text="Original" />
                  <Border Padding="4"
                          HorizontalAlignment="Stretch"
                          Background="#FFF5F7FA"
                          BorderBrush="{DynamicResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          ClipToBounds="True">
                    <Image MinHeight="200"
                           MaxHeight="320"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding OriginalPreviewImage, Mode=OneWay}"
                           Stretch="Uniform" />
                  </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <Grid Margin="0,0,0,6">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               Text="With your settings" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#FF5F6B76"
                               Text="Updating…"
                               Visibility="{Binding IsEditedPreviewBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                  </Grid>
                  <Border Padding="4"
                          HorizontalAlignment="Stretch"
                          Background="#FFF8FBFF"
                          BorderBrush="{DynamicResource AccentPrimaryBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          ClipToBounds="True">
                    <Image MinHeight="200"
                           MaxHeight="320"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding EditedPreviewImage, Mode=OneWay}"
                           Stretch="Uniform" />
                  </Border>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <UniformGrid Columns="3">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Size" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding FileSizeDisplay}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Dimensions" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding DimensionsDisplay}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="Format" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding FormatDisplay}" />
                  </StackPanel>
                </UniformGrid>
                <TextBlock Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="#FF5F6B76"
                           TextWrapping="Wrap"
                           Text="Preview updates per tab: Enhance (resize/filters), Background remover (transparency), or Object eraser (heal brush). Uses a smaller working copy for speed; exports use full resolution." />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Operation tabs (same pattern as VideoEnhancerPage) -->
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="Operation" />
              <Border Padding="10,10,2,2"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10">
                <WrapPanel Orientation="Horizontal">
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="0"
                          Content="Enhance &amp; convert">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEnhanceWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="1"
                          Content="Background remover">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBackgroundWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Command="{Binding SelectWorkspaceTabCommand}"
                          CommandParameter="2"
                          Content="Object eraser">
                    <Button.Style>
                      <Style BasedOn="{StaticResource VideoEnhanceOperationTabStyle}" TargetType="Button">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEraserWorkspace}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </WrapPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Enhance & convert -->
          <Border Margin="0,16,0,0"
                  Padding="16"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding IsEnhanceWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Output &amp; conversion" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Target format" />
                  <ComboBox Margin="0,6,0,0" ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding TargetFormat}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="JPEG / WebP quality" />
                  <Slider Margin="0,6,0,0" Maximum="100" Minimum="1" TickFrequency="1" IsSnapToTickEnabled="True"
                          Value="{Binding EncodingQuality}" />
                  <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF5F6B76"
                             Text="{Binding EncodingQuality, StringFormat=Quality {0}}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Resize intent" />
              <ComboBox Margin="0,0,0,12" ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding ResizeIntent}" />

              <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowScaleControls, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Scale factor" />
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ScaleFactorOptions}"
                          SelectedItem="{Binding ScaleFactor}" />
              </StackPanel>

              <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowMaxEdgeControls, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Longest edge (fit)" />
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding MaxEdgeOptions}" SelectedItem="{Binding SelectedMaxEdge}" />
              </StackPanel>

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76"
                         Text="Resize / upscale quality (interpolation)" />
              <ComboBox Margin="0,0,0,12" ItemsSource="{Binding UpscaleModes}" SelectedItem="{Binding UpscaleQualityMode}" />

              <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#FF5F6B76" Text="Creative filter" />
              <ComboBox ItemsSource="{Binding FilterKinds}" SelectedItem="{Binding SelectedFilter}" />
            </StackPanel>
          </Border>

          <!-- Background remover -->
          <Border Margin="0,16,0,0"
                  Padding="16"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding IsBackgroundWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Text="Background removal" />
              <TextBlock Margin="0,0,0,8"
                         FontSize="13"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Remove solid or studio backdrops on-device. Auto edge grows transparency inward from the photo border. Chroma key targets a specific color. Luminance removes bright whites." />

              <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Method" />
              <ComboBox Margin="0,0,0,12"
                        ItemsSource="{Binding BackgroundRemovalModes}"
                        SelectedItem="{Binding SelectedBackgroundRemovalMode}" />

              <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Sensitivity / tolerance (0–100)" />
              <Slider Margin="0,0,0,6" Maximum="100" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding BgTolerance}" />
              <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76" Text="{Binding BgTolerance, StringFormat={}{0}}" />

              <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Edge feather (blur alpha)" />
              <Slider Margin="0,0,0,6" Maximum="12" Minimum="0" SmallChange="0.25" LargeChange="1"
                      Value="{Binding BgFeatherSigma}" />
              <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76" Text="{Binding BgFeatherSigma, StringFormat={}{0:0.#} px sigma}" />

              <StackPanel Margin="0,0,0,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedBackgroundRemovalMode}" Value="{x:Static domainEnums:BackgroundRemovalMode.ChromaKey}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Key color (RGB)" />
                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Red" />
                <Slider Margin="0,0,0,8" Maximum="255" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding BgKeyR}" />
                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Green" />
                <Slider Margin="0,0,0,8" Maximum="255" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding BgKeyG}" />
                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Blue" />
                <Slider Margin="0,0,0,0" Maximum="255" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding BgKeyB}" />
              </StackPanel>

              <StackPanel Margin="0,0,0,12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedBackgroundRemovalMode}" Value="{x:Static domainEnums:BackgroundRemovalMode.Luminance}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Treat as background when brightness exceeds" />
                <Slider Margin="0,0,0,6" Maximum="1" Minimum="0" SmallChange="0.01" LargeChange="0.05"
                        Value="{Binding BgLuminanceThreshold}" />
                <TextBlock FontSize="11" Foreground="#FF5F6B76" Text="{Binding BgLuminanceThreshold, StringFormat={}{0:P0}}" />
              </StackPanel>

              <StackPanel Margin="0,0,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedBackgroundRemovalMode}" Value="{x:Static domainEnums:BackgroundRemovalMode.AutoEdge}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding SelectedBackgroundRemovalMode}" Value="{x:Static domainEnums:BackgroundRemovalMode.Luminance}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Expand removal at edges (px)" />
                <Slider Margin="0,0,0,0" Maximum="24" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding BgEdgeExpandPx}" />
              </StackPanel>

              <TextBlock Margin="0,16,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Export saves a PNG with transparency (filename suffix _nobg.png). Preview is downscaled for speed." />
            </StackPanel>
          </Border>

          <!-- Object eraser -->
          <StackPanel Margin="0,16,0,0"
                      Visibility="{Binding IsEraserWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Margin="0,0,0,12" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Brush &amp; heal" />
                <TextBlock Margin="0,0,0,10"
                           FontSize="13"
                           Foreground="#FF5F6B76"
                           TextWrapping="Wrap"
                           Text="Paint over distractions; the tool fills brushed regions using a blurred blend of surrounding pixels (fast on-device inpainting). Drag on the image below." />

                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Brush radius (px)" />
                <Slider Margin="0,0,0,6" Maximum="180" Minimum="4" SmallChange="2" LargeChange="8"
                        Value="{Binding EraserBrushRadiusPx}" />
                <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                           Text="{Binding EraserBrushRadiusPx, StringFormat={}{0:0}}" />

                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Brush softness" />
                <Slider Margin="0,0,0,6" Maximum="1" Minimum="0" SmallChange="0.05" LargeChange="0.15"
                        Value="{Binding EraserBrushSoftness}" />
                <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                           Text="{Binding EraserBrushSoftness, StringFormat={}{0:P0}}" />

                <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#FF5F6B76" Text="Heal blur strength" />
                <Slider Margin="0,0,0,6" Maximum="48" Minimum="1" SmallChange="1" LargeChange="4"
                        Value="{Binding EraserBlurSigma}" />
                <TextBlock Margin="0,0,0,12" FontSize="11" Foreground="#FF5F6B76"
                           Text="{Binding EraserBlurSigma, StringFormat={}{0:0.#}}" />

                <StackPanel Orientation="Horizontal">
                  <Button Margin="0,0,8,0"
                          Padding="12,6"
                          Command="{Binding ClearEraserStrokesCommand}"
                          Content="Clear all strokes"
                          Style="{DynamicResource OutlinedButtonStyle}" />
                  <Button Padding="12,6"
                          Command="{Binding UndoLastEraserStrokeCommand}"
                          Content="Undo last dab"
                          Style="{DynamicResource OutlinedButtonStyle}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="EraserSurface"
                    MinHeight="280"
                    HorizontalAlignment="Stretch"
                    Background="#FFE8ECF1"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Cursor="Cross"
                    MouseLeave="OnEraserMouseLeave"
                    MouseLeftButtonDown="OnEraserMouseDown"
                    MouseLeftButtonUp="OnEraserMouseUp"
                    MouseMove="OnEraserMouseMove">
              <Grid>
                <Image HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding OriginalPreviewImage, Mode=OneWay}"
                       Stretch="Uniform"
                       IsHitTestVisible="False" />
              </Grid>
            </Border>
          </StackPanel>

          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding ProgressStatusText}" />
              <TextBlock Margin="0,6,0,0" Foreground="#FF5F6B76" Text="{Binding ProgressDetailText}" />
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True" Background="#FFE8EEF4">
                <ProgressBar Height="12" Maximum="100" Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>
              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="16" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22" Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}" Text="Saved successfully" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder" Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100" Command="{Binding CancelCommand}" Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220"
                    Command="{Binding ProcessPhotoCommand}"
                    Content="{Binding ProcessPrimaryLabel}"
                    Style="{DynamicResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    MinWidth="260"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch">
          <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Formats" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Pick PNG for lossless, JPEG or WebP for smaller shares, TIFF for print pipelines, BMP for legacy apps." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Upscale &amp; AI-style enhancement" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="High Quality uses Lanczos resampling. AI Enhanced adds local sharpening and tone refinement on-device (no cloud). None uses faster bicubic when resizing." />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Filters" />
              <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Combine resize with sepia, vintage, warmth, cool tones, or dramatic contrast for creative finishing." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
