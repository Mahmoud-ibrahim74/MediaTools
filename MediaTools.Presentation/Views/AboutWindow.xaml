<mah:MetroWindow x:Class="MediaTools.Presentation.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="About Media Tools"
                 Width="460" Height="540"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ShowMaxRestoreButton="False"
                 ShowMinButton="False"
                 Background="{DynamicResource ContentBackgroundBrush}"
                 GlowBrush="{DynamicResource AccentPrimaryBrush}">
    <mah:MetroWindow.Resources>
        <Style x:Key="SocialButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#11808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="26" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22808080" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </mah:MetroWindow.Resources>
    <Grid>
        <Border Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Awesome Avatar with glow -->
                <Grid Width="150" Height="150" Margin="0,0,0,24">
                    <!-- Glow Effect -->
                    <Border CornerRadius="75" Background="{DynamicResource AccentPrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF007ACC" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <!-- Image -->
                    <Border CornerRadius="75" BorderBrush="{DynamicResource ContentBackgroundBrush}" BorderThickness="4">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/owner.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                
                <TextBlock Text="Mahmoud Ibrahim" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Software Engineer &amp; .NET Developer" FontSize="14" Foreground="#FF5F6B76" HorizontalAlignment="Center" Margin="0,6,0,24"/>
                
                <TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Margin="10" CommandParameter="https://www.linkedin.com/in/mahmoud-ibrahim74?utm_source=share_via&amp;utm_content=profile&amp;utm_medium=member_android" Click="OpenLink_Click" Style="{StaticResource SocialButtonStyle}" ToolTip="LinkedIn">
                        <iconPacks:PackIconMaterial Kind="Linkedin" Width="26" Height="26" Foreground="#FF0A66C2"/>
                    </Button>
                    <Button Margin="10" CommandParameter="https://github.com/Mahmoud-ibrahim74" Click="OpenLink_Click" Style="{StaticResource SocialButtonStyle}" ToolTip="GitHub">
                        <iconPacks:PackIconMaterial Kind="Github" Width="26" Height="26" Foreground="#FF333333"/>
                    </Button>
                    <Button Margin="10" CommandParameter="https://wa.me/201069903556" Click="OpenLink_Click" Style="{StaticResource SocialButtonStyle}" ToolTip="WhatsApp">
                        <iconPacks:PackIconMaterial Kind="Whatsapp" Width="26" Height="26" Foreground="#FF25D366"/>
                    </Button>
                    <Button Margin="10" CommandParameter="https://www.facebook.com/Houda405/" Click="OpenLink_Click" Style="{StaticResource SocialButtonStyle}" ToolTip="Facebook">
                        <iconPacks:PackIconMaterial Kind="Facebook" Width="26" Height="26" Foreground="#FF1877F2"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
