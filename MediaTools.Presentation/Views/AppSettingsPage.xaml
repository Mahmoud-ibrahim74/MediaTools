<Page x:Class="MediaTools.Presentation.Views.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="App Settings"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="AppSettingsScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=AppSettingsScroll}"
            HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
          <StackPanel Margin="0,0,0,20">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="App settings" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#FF5F6B76"
                       TextWrapping="Wrap"
                       Text="Choose where Video Compress, Photo Enhancer, Audio Converter, Thumbnail Generator, Screen Recorder, and Video tools save output files." />
          </StackPanel>

          <Border Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Saved files folder" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="All exports from those tools use this folder. It is created automatically if needed." />
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="36"
                         VerticalContentAlignment="Center"
                         Text="{Binding SaveFolderPathDraft, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        MinWidth="110"
                        Command="{Binding BrowseSaveFolderCommand}"
                        Content="Browse…"
                        Style="{DynamicResource OutlinedButtonStyle}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Hardware Encoder" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Click Detect Encoders to run a short test on this PC. Only encoders that actually work with your GPU and drivers stay selectable; the rest stay disabled. Software (CPU) is always available." />
              <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <Button MinWidth="160"
                        Command="{Binding DetectEncodersCommand}"
                        Content="Detect Encoders"
                        Style="{DynamicResource PrimaryButtonStyle}" />
                <controls:ProgressRing Width="22"
                                       Height="22"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsActive="{Binding IsDetectingEncoders}" />
              </StackPanel>

              <Border Margin="0,16,0,0"
                      Padding="12"
                      Background="#FFFFF8E1"
                      BorderBrush="#FFFFE082"
                      BorderThickness="1"
                      CornerRadius="8"
                      Visibility="{Binding ShowNoGpuEncoderWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Foreground="#FF6D4C41"
                           TextWrapping="Wrap"
                           Text="No GPU encoders detected. Software encoding will be used." />
              </Border>

              <ListBox Margin="0,16,0,0"
                       Padding="0"
                       Background="Transparent"
                       BorderThickness="0"
                       ItemsSource="{Binding EncoderRows}"
                       SelectedItem="{Binding SelectedEncoderRow, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="RowBd"
                                  Padding="12"
                                  Background="White"
                                  BorderBrush="#FFE0E6EC"
                                  BorderThickness="2"
                                  CornerRadius="8">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <iconPacks:PackIconMaterial Grid.Column="0"
                                                  Width="22"
                                                  Height="22"
                                                  Margin="0,2,12,0"
                                                  VerticalAlignment="Top">
                        <iconPacks:PackIconMaterial.Style>
                          <Style TargetType="iconPacks:PackIconMaterial">
                            <Setter Property="Kind" Value="Close" />
                            <Setter Property="Foreground" Value="#FFB0BEC5" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                <Setter Property="Kind" Value="Check" />
                                <Setter Property="Foreground" Value="#FF43A047" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </iconPacks:PackIconMaterial.Style>
                      </iconPacks:PackIconMaterial>
                      <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap">
                          <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding FullLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#FF5F6B76"
                                   Text="{Binding Description, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <RadioButton Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Focusable="False"
                                   IsHitTestVisible="False"
                                   IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=OneWay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Screen Recorder hotkeys" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Bandicam-style shortcuts work system-wide while Media Tools is running (even when another app is focused). Defaults: F9 start, F10 pause/resume. Click Set, then press the desired combination. The same key cannot be assigned to more than one action." />
              <Border Margin="0,12,0,0"
                      Padding="12"
                      Background="#FFFFF8E1"
                      BorderBrush="#FFFFE082"
                      BorderThickness="1"
                      CornerRadius="8"
                      Visibility="{Binding IsHotkeyCaptureActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Foreground="#FF6D4C41"
                           Text="{Binding HotkeyCaptureHint}"
                           TextWrapping="Wrap" />
              </Border>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="154" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Start recording" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="12,0,12,0"
                         MinHeight="36"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         Text="{Binding DraftStartHotkeyDisplay, Mode=OneWay}" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Command="{Binding BeginCaptureStartHotkeyCommand}"
                        Content="Set…"
                        Style="{DynamicResource OutlinedButtonStyle}" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        MinWidth="72"
                        Command="{Binding ClearDraftStartHotkeyCommand}"
                        Content="Clear"
                        Style="{DynamicResource OutlinedButtonStyle}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,12,0,0"
                           VerticalAlignment="Center"
                           Text="Pause / resume" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="12,12,12,0"
                         MinHeight="36"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         Text="{Binding DraftPauseHotkeyDisplay, Mode=OneWay}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,12,8,0"
                        MinWidth="72"
                        Command="{Binding BeginCapturePauseHotkeyCommand}"
                        Content="Set…"
                        Style="{DynamicResource OutlinedButtonStyle}" />
                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,12,0,0"
                        MinWidth="72"
                        Command="{Binding ClearDraftPauseHotkeyCommand}"
                        Content="Clear"
                        Style="{DynamicResource OutlinedButtonStyle}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Notifications" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Windows toast alerts when a tool finishes (success or failure). Turn off if you prefer only the in-app status." />
              <CheckBox Margin="0,14,0,0"
                        Content="Show completion notifications (Windows Action Center)"
                        IsChecked="{Binding ToastNotificationsEnabledDraft}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.SystemControlErrorText}" Text="Reset App &amp; Cache" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Deletes all cached tools and resets your preferences back to their defaults." />
              <Button Margin="0,14,0,0"
                      HorizontalAlignment="Left"
                      MinWidth="160"
                      Command="{Binding ResetAppCommand}"
                      Content="Reset to Defaults"
                      Style="{DynamicResource OutlinedButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="16"
                  Background="#FFF5F7FA"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <!-- <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Width="20"
                                          Height="20"
                                          VerticalAlignment="Top"
                                          Foreground="#FF5F6B76"
                                          Kind="InformationOutline" />
              <TextBlock Margin="10,0,0,0"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Settings (folder path, hardware encoder choice, scan results, notification toggle, and screen recorder hotkeys) are stored under your user profile (AppData\Roaming\MediaTools\settings.json)." />
            </StackPanel> -->
          </Border>

          <StackPanel Margin="0,24,0,32"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <Button MinWidth="140"
                    Command="{Binding SaveSettingsCommand}"
                    Content="Save"
                    Style="{DynamicResource PrimaryButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
