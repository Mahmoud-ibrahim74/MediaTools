<Page x:Class="MediaTools.Presentation.Views.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="App Settings"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}">
    <ScrollViewer x:Name="AppSettingsScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=AppSettingsScroll}"
            HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
          <StackPanel Margin="0,0,0,20">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="App settings" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#FF5F6B76"
                       TextWrapping="Wrap"
                       Text="Choose where Video Compress, Photo Enhancer, Audio Converter, Thumbnail Generator, Screen Recorder, and Video tools save output files." />
          </StackPanel>

          <Border Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Saved files folder" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="All exports from those tools use this folder. It is created automatically if needed." />
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="36"
                         VerticalContentAlignment="Center"
                         Text="{Binding SaveFolderPathDraft, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        MinWidth="110"
                        Command="{Binding BrowseSaveFolderCommand}"
                        Content="Browse…"
                        Style="{DynamicResource OutlinedButtonStyle}" />
              </Grid>
              <Button Margin="0,16,0,0"
                      HorizontalAlignment="Left"
                      MinWidth="120"
                      Command="{Binding SaveSettingsCommand}"
                      Content="Save"
                      Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Notifications" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Windows toast alerts when a tool finishes (success or failure). Turn off if you prefer only the in-app status." />
              <CheckBox Margin="0,14,0,0"
                        Content="Show completion notifications (Windows Action Center)"
                        IsChecked="{Binding ToastNotificationsEnabledDraft}" />
            </StackPanel>
          </Border>

          <Border Margin="0,16,0,0"
                  Padding="16"
                  Background="#FFF5F7FA"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Width="20"
                                          Height="20"
                                          VerticalAlignment="Top"
                                          Foreground="#FF5F6B76"
                                          Kind="InformationOutline" />
              <TextBlock Margin="10,0,0,0"
                         Foreground="#FF5F6B76"
                         TextWrapping="Wrap"
                         Text="Settings (folder path and notification toggle) are stored under your user profile (AppData\Roaming\MediaTools\settings.json)." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
