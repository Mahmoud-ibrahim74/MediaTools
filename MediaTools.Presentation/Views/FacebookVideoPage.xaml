<Page x:Class="MediaTools.Presentation.Views.FacebookVideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:vm="clr-namespace:MediaTools.Presentation.ViewModels"
      Title="Facebook Video Downloader"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}"
        UseLayoutRounding="True">
    <ScrollViewer x:Name="FacebookVideoScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=FacebookVideoScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="340" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- HEADER with animated waveform bars                    -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="28" Height="28"
                                            VerticalAlignment="Center"
                                            Foreground="#FF1877F2"
                                            Kind="Facebook" />
                <TextBlock Margin="10,0,0,0" FontSize="26" FontWeight="SemiBold" Text="Facebook Video Queue Downloader" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Add multiple Facebook Video or Reel links to the sequential download queue. Downloads proceed safely one by one to avoid Facebook rate limits and bot bans." />
            </StackPanel>

            <!-- Animated waveform decoration -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Opacity="0.6">
              <StackPanel.Resources>
                <Storyboard x:Key="WaveAnim" RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                                   From="8" To="32" Duration="0:0:0.4" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                                   From="24" To="12" Duration="0:0:0.5" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                                   From="12" To="28" Duration="0:0:0.35" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height"
                                   From="20" To="8" Duration="0:0:0.45" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height"
                                   From="16" To="32" Duration="0:0:0.38" AutoReverse="True" />
                </Storyboard>
              </StackPanel.Resources>
              <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard Storyboard="{StaticResource WaveAnim}" />
                </EventTrigger>
              </StackPanel.Triggers>
              <Border x:Name="Bar1" Width="4" Height="8" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar2" Width="4" Height="24" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar3" Width="4" Height="12" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar4" Width="4" Height="20" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar5" Width="4" Height="16" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- URL INPUT & FORMAT SELECTION CARD                      -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"
                         Text="Add Facebook Video to Queue" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Padding="12,10"
                         FontSize="14"
                         Text="{Binding FacebookUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsNotQueueRunning}">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                      <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding PasteFromClipboardCommand}"
                        IsEnabled="{Binding IsNotQueueRunning}"
                        Style="{DynamicResource OutlinedButtonStyle}"
                        ToolTip="Paste URL from clipboard">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentPaste" />
                    <TextBlock VerticalAlignment="Center" Text="Paste" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="130"
                        Command="{Binding AddToQueueCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="PlaylistPlus" />
                    <TextBlock VerticalAlignment="Center" Text="Add to Queue" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Format, Resolution & Quality Selection for added items -->
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Format" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableFormats}"
                            SelectedItem="{Binding SelectedFormat}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Resolution" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableResolutions}"
                            SelectedItem="{Binding SelectedResolution}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Video Quality" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableQualities}"
                            SelectedItem="{Binding SelectedQuality}" />
                </StackPanel>
              </Grid>

              <!-- Input Error Banner -->
              <TextBlock Margin="0,10,0,0"
                         Foreground="{DynamicResource StatusDangerBrush}"
                         FontSize="12"
                         FontWeight="Medium"
                         TextWrapping="Wrap"
                         Text="{Binding InputErrorMessage}"
                         Visibility="{Binding HasInputError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- QUEUE CONTROLS & OVERALL STATUS CARD                   -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Queue status header -->
                <StackPanel Grid.Column="0">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                                Kind="TrayFull" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="16"
                               Text="Sequential Download Queue" />
                    <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="10"
                            Background="#1A1877F2" VerticalAlignment="Center">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF1877F2"
                                 Text="{Binding TotalQueueCount, StringFormat='{}{0} item(s)'}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FF5F6B76"
                             Text="{Binding QueueStatusMessage}" />
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Margin="0,0,8,0" Padding="12,7"
                          Command="{Binding ClearCompletedCommand}"
                          IsEnabled="{Binding IsNotQueueRunning}"
                          Style="{DynamicResource OutlinedButtonStyle}"
                          ToolTip="Remove finished downloads from list">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,6,0" Kind="CheckAll" />
                      <TextBlock Text="Clear Done" />
                    </StackPanel>
                  </Button>

                  <Button Margin="0,0,8,0" Padding="12,7"
                          Command="{Binding ClearAllCommand}"
                          IsEnabled="{Binding IsNotQueueRunning}"
                          Style="{DynamicResource OutlinedButtonStyle}"
                          ToolTip="Clear entire queue">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,6,0" Kind="DeleteSweepOutline" />
                      <TextBlock Text="Clear All" />
                    </StackPanel>
                  </Button>

                  <Button MinWidth="140" Padding="16,8"
                          Command="{Binding StartQueueCommand}"
                          Visibility="{Binding IsNotQueueRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                          Style="{DynamicResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0" Kind="Play" />
                      <TextBlock Text="Start Queue" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>

                  <Button MinWidth="130" Padding="16,8"
                          Command="{Binding CancelQueueCommand}"
                          Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                          Style="{DynamicResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                      <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0" Kind="Stop" />
                      <TextBlock Text="Stop Queue" FontWeight="SemiBold" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Overall progress bar -->
              <Grid Margin="0,16,0,0">
                <ProgressBar Height="8" Maximum="100"
                             Style="{DynamicResource MetroProgressBarRounded}"
                             Value="{Binding OverallProgressPercent}" />
              </Grid>

              <!-- Anti-Ban Protection Banner (shown during inter-download delay) -->
              <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                      Background="#141877F2" BorderBrush="#FF1877F2" BorderThickness="1"
                      Visibility="{Binding ShowCooldownNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconMaterial Width="16" Height="16" VerticalAlignment="Center"
                                              Foreground="#FF1877F2" Kind="ShieldCheck" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                             Foreground="#FF1877F2" Text="{Binding CooldownMessage}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- QUEUE ITEMS LIST                                       -->
          <!-- ══════════════════════════════════════════════════════ -->
          <StackPanel Margin="0,16,0,32">
            <!-- Empty state placeholder -->
            <Border Padding="40,32" Style="{DynamicResource CardBorderStyle}"
                    Visibility="{Binding IsEmptyQueue, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel HorizontalAlignment="Center">
                <iconPacks:PackIconMaterial Width="48" Height="48"
                                            HorizontalAlignment="Center"
                                            Foreground="#FF9AA7B8"
                                            Kind="PlaylistMusicOutline" />
                <TextBlock Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#FF5F6B76"
                           Text="Your download queue is empty" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#FF9AA7B8"
                           HorizontalAlignment="Center"
                           Text="Paste one or more Facebook links above and click 'Add to Queue'." />
              </StackPanel>
            </Border>

            <!-- Items List -->
            <ItemsControl ItemsSource="{Binding QueueItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FacebookQueueItemViewModel}">
                  <Border Margin="0,0,0,12" Padding="16" Style="{DynamicResource CardBorderStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <!-- Thumbnail or default icon -->
                      <Border Grid.Column="0" Width="80" Height="54" CornerRadius="6"
                              ClipToBounds="True" Background="#FF1E293B" Margin="0,0,16,0">
                        <Grid>
                          <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                          <!-- Fallback icon if no thumbnail -->
                          <iconPacks:PackIconMaterial Width="24" Height="24"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#FF94A3B8"
                                                      Kind="Facebook" />
                        </Grid>
                      </Border>

                      <!-- Info & Progress details -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Title line -->
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Title}" />

                        <!-- Author & Status line -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock FontSize="12" Foreground="#FF5F6B76"
                                     Text="{Binding AuthorName}" />
                          <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="#FF9AA7B8"
                                     Text="{Binding DurationDisplay}"
                                     Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisibilityConverter}}" />
                          
                          <!-- Status badge -->
                          <TextBlock Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding ProgressStatusText}" />
                                <Setter Property="Foreground" Value="#FF5F6B76" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:FacebookQueueItemStatus.Downloading}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:FacebookQueueItemStatus.Muxing}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:FacebookQueueItemStatus.Completed}">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:FacebookQueueItemStatus.Failed}">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <!-- Speed & ETA if active -->
                          <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="#FF9AA7B8"
                                     Text="{Binding DownloadSpeedDisplay}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                          <TextBlock Margin="8,0,0,0" FontSize="11" Foreground="#FF9AA7B8"
                                     Text="{Binding EtaDisplay, StringFormat='ETA: {0}'}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Individual Progress bar -->
                        <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100"
                                     Style="{DynamicResource MetroProgressBarRounded}"
                                     Value="{Binding ProgressPercentDisplay}"
                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Error detail if failed -->
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource StatusDangerBrush}"
                                   TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                      </StackPanel>

                      <!-- Action Button on Right -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Open Folder Button -->
                        <Button Padding="10,6" Margin="0,0,6,0"
                                Command="{Binding OpenFolderCommand}"
                                ToolTip="Open folder with downloaded file">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:FacebookQueueItemStatus.Completed}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,4,0" Kind="FolderOpen" />
                            <TextBlock FontSize="12" Text="Open" />
                          </StackPanel>
                        </Button>

                        <!-- Remove from queue button -->
                        <Button Padding="8,6"
                                Command="{Binding RemoveCommand}"
                                IsEnabled="{Binding CanRemove}"
                                Style="{DynamicResource OutlinedButtonStyle}"
                                ToolTip="Remove from queue">
                          <iconPacks:PackIconMaterial Width="14" Height="14" Kind="Close" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- TIPS SIDEBAR                                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Expander Grid.Column="1"
                  MinWidth="260"
                  MaxWidth="400"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  ExpandDirection="Down"
                  Header="Tips &amp; queue safety"
                  IsExpanded="False">
          <StackPanel>
            <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Anti-Ban Protection" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Downloading multiple videos simultaneously can trigger Facebook's rate-limits or temporary IP block. The queue downloads strictly one video at a time with a safety cooldown." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Batch URL Adding" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="You can paste multiple links at once separated by newlines or spaces. They will all be validated and queued in order." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="DASH Stream Merging" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Facebook serves high-definition video and audio in separate tracks. FFmpeg multiplexes each item into a clean, standalone MP4 file upon download completion." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
