<Page x:Class="MediaTools.Presentation.Views.FacebookVideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Facebook Video Downloader"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{DynamicResource ContentBackgroundBrush}"
        UseLayoutRounding="True">
    <ScrollViewer x:Name="FacebookVideoScroll"
                  Padding="24"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding ViewportWidth, ElementName=FacebookVideoScroll}"
            HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Stretch">

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- HEADER with animated waveform bars                    -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="Facebook Video Downloader" />
              <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#FF5F6B76" TextWrapping="Wrap"
                         Text="Paste a Facebook Video, Reel, or Watch link below to download in highest quality with automatic DASH stream merging via FFmpeg." />
            </StackPanel>

            <!-- Animated waveform decoration -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Opacity="0.6">
              <StackPanel.Resources>
                <Storyboard x:Key="WaveAnim" RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                                   From="8" To="32" Duration="0:0:0.4" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                                   From="24" To="12" Duration="0:0:0.5" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                                   From="12" To="28" Duration="0:0:0.35" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height"
                                   From="20" To="8" Duration="0:0:0.45" AutoReverse="True" />
                  <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height"
                                   From="16" To="32" Duration="0:0:0.38" AutoReverse="True" />
                </Storyboard>
              </StackPanel.Resources>
              <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard Storyboard="{StaticResource WaveAnim}" />
                </EventTrigger>
              </StackPanel.Triggers>
              <Border x:Name="Bar1" Width="4" Height="8" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar2" Width="4" Height="24" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar3" Width="4" Height="12" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar4" Width="4" Height="20" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
              <Border x:Name="Bar5" Width="4" Height="16" Margin="1,0" CornerRadius="2"
                      Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" />
            </StackPanel>
          </Grid>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- URL INPUT CARD                                        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Padding="20" Style="{DynamicResource CardBorderStyle}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <iconPacks:PackIconMaterial Width="22" Height="22"
                                            VerticalAlignment="Center"
                                            Foreground="#FF1877F2"
                                            Kind="Facebook" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15"
                           Text="Facebook Link" />
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Padding="12,10"
                         FontSize="14"
                         Text="{Binding FacebookUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                      <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding PasteFromClipboardCommand}"
                        Style="{DynamicResource OutlinedButtonStyle}"
                        ToolTip="Paste Facebook URL from clipboard">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentPaste" />
                    <TextBlock VerticalAlignment="Center" Text="Paste" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="110"
                        Command="{Binding FetchVideoInfoCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="16" Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="Magnify" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding FetchButtonText}" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Fetching spinner -->
              <StackPanel Orientation="Horizontal"
                          Margin="0,12,0,0"
                          Visibility="{Binding IsFetching, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="16" Height="16" CornerRadius="8"
                        BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                  <Border.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" />
                  </Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                           Storyboard.TargetProperty="Angle"
                                           From="0" To="360" Duration="0:0:1" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Border.Triggers>
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF5F6B76"
                           Text="Fetching Facebook video information…" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- ERROR CARD                                            -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="16"
                  BorderBrush="{DynamicResource StatusDangerBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                  Visibility="{Binding ShowErrorCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            Foreground="{DynamicResource StatusDangerBrush}"
                                            Kind="AlertCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusDangerBrush}"
                           Text="Error" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                         Foreground="#FF5F6B76"
                         Text="{Binding ErrorMessage}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- VIDEO INFO CARD (shown after successful fetch)        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="0"
                  Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowVideoInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border CornerRadius="10" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Thumbnail + gradient overlay -->
                <Grid Grid.Row="0" Height="200">
                  <Image Source="{Binding ThumbnailImage}"
                         Stretch="UniformToFill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                  <!-- Gradient overlay for text readability -->
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.3" />
                        <GradientStop Color="#CC000000" Offset="1.0" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <!-- Video title overlay on thumbnail -->
                  <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="52"
                               Text="{Binding VideoTitle}" />
                  </StackPanel>
                  <!-- Duration badge -->
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,12,12,0" Padding="8,4"
                          CornerRadius="6"
                          Background="#CC000000">
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding DurationDisplay}" />
                  </Border>
                </Grid>

                <!-- Video metadata row -->
                <Border Grid.Row="1" Padding="20,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="16" Height="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF5F6B76"
                                                    Kind="AccountCircleOutline" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Text="{Binding AuthorName}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <iconPacks:PackIconMaterial Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF9AA7B8"
                                                    Kind="Eye" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#FF9AA7B8"
                                   Text="{Binding ViewCountDisplay}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Padding="10,6"
                            CornerRadius="16"
                            Background="#141877F2">
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="#FF1877F2"
                                                    Kind="Facebook" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF1877F2"
                                   Text="Facebook" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- FORMAT & QUALITY CARD                                 -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowVideoInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="TuneVariant" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15"
                           Text="Format, Resolution &amp; Quality" />
              </StackPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Video format" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableFormats}"
                            SelectedItem="{Binding SelectedFormat}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Resolution" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableResolutions}"
                            SelectedItem="{Binding SelectedResolution}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock FontSize="12" Foreground="#FF5F6B76" Text="Video quality" />
                  <ComboBox Margin="0,6,0,0"
                            ItemsSource="{Binding AvailableQualities}"
                            SelectedItem="{Binding SelectedQuality}" />
                </StackPanel>
              </Grid>

              <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#FF9AA7B8" TextWrapping="Wrap"
                         Text="Facebook serves high-definition video and audio in separate DASH tracks. MediaTools automatically merges them into a clean video container via FFmpeg." />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- DOWNLOAD PROGRESS CARD                                -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="20" Style="{DynamicResource CardBorderStyle}"
                  Visibility="{Binding ShowProgressCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <iconPacks:PackIconMaterial Width="20" Height="20"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            Kind="Download" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding ProgressStatusText}" />
              </StackPanel>

              <!-- Speed / ETA row -->
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="#FF5F6B76"
                           Text="{Binding DownloadSpeedDisplay}" />
                <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="#FF5F6B76"
                           Text="{Binding EtaDisplay, StringFormat='ETA: {0}'}" />
              </StackPanel>

              <!-- Progress bar -->
              <Border Margin="0,16,0,0" CornerRadius="6" ClipToBounds="True"
                      Background="#FFE8EEF4">
                <ProgressBar Height="14" Maximum="100"
                             Style="{DynamicResource MetroProgressBarRounded}"
                             IsIndeterminate="{Binding IsMuxing}"
                             Value="{Binding ProgressPercentDisplay, Mode=OneWay}" />
              </Border>

              <TextBlock Margin="0,12,0,0" FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentPrimaryBrush}"
                         Text="{Binding ProgressPercentDisplay, Mode=OneWay, StringFormat={}{0}%}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- SUCCESS CARD                                          -->
          <!-- ══════════════════════════════════════════════════════ -->
          <Border Margin="0,16,0,0" Padding="16"
                  BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="2"
                  Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                  Visibility="{Binding ShowResultCard, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="22" Height="22"
                                            Foreground="{DynamicResource StatusSuccessBrush}"
                                            Kind="CheckCircleOutline" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusSuccessBrush}"
                           Text="Download complete!" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" Text="{Binding ResultMessage}" TextWrapping="Wrap" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                      Command="{Binding OpenOutputFolderCommand}"
                      Content="Open output folder"
                      Style="{DynamicResource PrimaryButtonStyle}" />
            </StackPanel>
          </Border>

          <!-- ══════════════════════════════════════════════════════ -->
          <!-- ACTION BUTTONS                                        -->
          <!-- ══════════════════════════════════════════════════════ -->
          <StackPanel Margin="0,24,0,32" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,12,0" MinWidth="100"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Style="{DynamicResource OutlinedButtonStyle}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button MinWidth="220"
                    Command="{Binding DownloadVideoCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="18" Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Download" />
                <TextBlock VerticalAlignment="Center" Text="Download Video" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- TIPS SIDEBAR                                          -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Expander Grid.Column="1"
                  MinWidth="260"
                  MaxWidth="400"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  ExpandDirection="Down"
                  Header="Tips &amp; reference"
                  IsExpanded="False">
          <StackPanel>
            <Border Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Supported Facebook URLs" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Supports Facebook Watch (facebook.com/watch/?v=...), Facebook Reels (facebook.com/reel/...), and short links (fb.watch/...). Public videos are downloaded directly." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="DASH Stream Merging" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Facebook streams 1080p/720p video separately from audio. MediaTools uses FFmpeg behind the scenes to mux video and audio without re-encoding quality loss." />
              </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="16" Style="{DynamicResource CardBorderStyle}">
              <StackPanel>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Privacy &amp; Permissions" />
                <TextBlock Foreground="#FF5F6B76" TextWrapping="Wrap"
                           Text="Private group videos or restricted posts require credentials. Ensure the video you are trying to download is public." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
