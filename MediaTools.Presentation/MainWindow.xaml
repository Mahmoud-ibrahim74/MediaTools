<mah:MetroWindow x:Class="MediaTools.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="MediaTools"
                 Width="1200"
                 Height="760"
                 MinWidth="960"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ContentBackgroundBrush}"
                 GlowBrush="{DynamicResource AccentPrimaryBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{DynamicResource SideMenuBackgroundBrush}">
      <Grid Margin="0,16,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,0,16,24">
          <iconPacks:PackIconMaterial Width="28"
                                      Height="28"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentPrimaryBrush}"
                                      Kind="VideoOutline" />
          <TextBlock Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SideMenuTextBrush}"
                     Text="MediaTools" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,0">
            <TextBlock Margin="12,0,12,8"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SideMenuMutedTextBrush}"
                       Text="OVERVIEW" />
            <Button Margin="4,2"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Dashboard"
                    Cursor="Hand">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SideMenuTextBrush}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Kind="ViewDashboardOutline" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Dashboard" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding CurrentNavigationKey}" Value="Dashboard">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>

            <TextBlock Margin="12,16,12,8"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SideMenuMutedTextBrush}"
                       Text="TOOLS" />

            <Button Margin="4,2"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="VideoCompress"
                    Cursor="Hand">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SideMenuTextBrush}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Kind="FolderZipOutline" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Video Compress" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding CurrentNavigationKey}" Value="VideoCompress">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>

            <Button Margin="4,2"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="PhotoEnhancer"
                    Cursor="Hand">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SideMenuTextBrush}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Kind="ImageFilterHdrOutline" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Photo Enhancer" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding CurrentNavigationKey}" Value="PhotoEnhancer">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>

            <Button Margin="4,2"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AudioEnhancer"
                    Cursor="Hand">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SideMenuTextBrush}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Kind="MusicNoteOutline" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Audio Converter" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding CurrentNavigationKey}" Value="AudioEnhancer">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>

            <TextBlock Margin="12,16,12,8"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SideMenuMutedTextBrush}"
                       Text="SETTINGS" />

            <Button Margin="4,2"
                    Padding="12,10"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AppSettings"
                    Cursor="Hand">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Foreground" Value="{DynamicResource SideMenuTextBrush}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                          <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Kind="CogOutline" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="App settings" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding CurrentNavigationKey}" Value="AppSettings">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideMenuActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>

            <RadioButton Margin="4,2"
                         Padding="12,10"
                         HorizontalAlignment="Stretch"
                         Foreground="{DynamicResource SideMenuMutedTextBrush}"
                         IsEnabled="False"
                         Style="{DynamicResource SideNavRadioStyle}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Kind="SwapHorizontal" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Video Convert" />
              </StackPanel>
            </RadioButton>

            <RadioButton Margin="4,2"
                         Padding="12,10"
                         HorizontalAlignment="Stretch"
                         Foreground="{DynamicResource SideMenuMutedTextBrush}"
                         IsEnabled="False"
                         Style="{DynamicResource SideNavRadioStyle}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Kind="ImageOutline" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="Thumbnail" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="16,12,16,0"
                   FontSize="11"
                   Foreground="{DynamicResource SideMenuMutedTextBrush}"
                   Text="{Binding AppVersionDisplay, StringFormat='v{0}'}" />
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Background="{DynamicResource ContentBackgroundBrush}">
      <Frame x:Name="ContentFrame"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             NavigationUIVisibility="Hidden"
             Background="Transparent" />
    </Border>
  </Grid>
</mah:MetroWindow>
