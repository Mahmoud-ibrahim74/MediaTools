<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="AccentPrimaryColor">#FF0078D7</Color>
  <Color x:Key="AccentDarkColor">#FF005A9E</Color>
  <Color x:Key="AccentLightColor">#FF4DA3E8</Color>
  <Color x:Key="SideMenuBackgroundColor">#FF0F1B2E</Color>
  <Color x:Key="SideMenuHoverColor">#FF1C2E4A</Color>
  <Color x:Key="SideMenuActiveColor">#FF243B5C</Color>
  <Color x:Key="SideMenuTextColor">#FFE8EEF5</Color>
  <Color x:Key="SideMenuMutedTextColor">#FF9AA7B8</Color>
  <Color x:Key="ContentBackgroundColor">#FFF3F5F8</Color>
  <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
  <Color x:Key="CardBorderColor">#FFE1E6EC</Color>
  <Color x:Key="StatusSuccessColor">#FF2E7D32</Color>
  <Color x:Key="StatusWarningColor">#FFF9A825</Color>
  <Color x:Key="StatusDangerColor">#FFC62828</Color>

  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
  <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
  <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
  <SolidColorBrush x:Key="SideMenuBackgroundBrush" Color="{StaticResource SideMenuBackgroundColor}" />
  <SolidColorBrush x:Key="SideMenuHoverBrush" Color="{StaticResource SideMenuHoverColor}" />
  <SolidColorBrush x:Key="SideMenuActiveBrush" Color="{StaticResource SideMenuActiveColor}" />
  <SolidColorBrush x:Key="SideMenuTextBrush" Color="{StaticResource SideMenuTextColor}" />
  <SolidColorBrush x:Key="SideMenuMutedTextBrush" Color="{StaticResource SideMenuMutedTextColor}" />
  <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
  <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />

  <SolidColorBrush x:Key="MahApps.Brushes.AccentBase" Color="{StaticResource AccentPrimaryColor}" />
  <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{StaticResource AccentPrimaryColor}" />

</ResourceDictionary>
