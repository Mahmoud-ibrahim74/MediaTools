<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>MediaToolsInstaller</OutputName>
    <OutputType>Package</OutputType>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64;x86;Any CPU</Platforms>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=..\MediaTools.Presentation\bin\$(Configuration)\net9.0-windows10.0.17763.0\</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaTools.Presentation\MediaTools.Presentation.csproj" />
  </ItemGroup>
</Project>
